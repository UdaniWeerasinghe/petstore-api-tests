<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Petstore API Test Suite" parallel="classes" thread-count="3">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Pet API Tests">
        <classes>
            <class name="com.petstore.tests.PetTests"/>
        </classes>
    </test>

    <test name="Store API Tests">
        <classes>
            <class name="com.petstore.tests.StoreTests"/>
        </classes>
    </test>

    <test name="User API Tests">
        <classes>
            <class name="com.petstore.tests.UserTests"/>
        </classes>
    </test>

</suite>
